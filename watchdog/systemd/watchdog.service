[Unit]
Description=Сторож сервера: детекторы, разбор дельты, уведомления владельцу
Documentation=file:/home/plg/telegram-server-bot/docs/watchdog-roadmap.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=plg
Group=plg
WorkingDirectory=/home/plg/telegram-server-bot
ExecStart=/home/plg/telegram-server-bot/watchdog/run.sh

# Секреты отдаёт systemd — файл читает root, процессу достаются только значения.
EnvironmentFile=/etc/telegram-server-bot.env
# Telegram и Anthropic у провайдера недоступны напрямую; свои домены сборщик
# проверяет мимо прокси (см. collect.py). Для остальных провайдеров прокси не
# помеха — проверено, MiniMax Code через него работает.
Environment="HTTPS_PROXY=http://127.0.0.1:18443"
Environment="HTTP_PROXY=http://127.0.0.1:18443"
Environment="WATCHDOG_STATE_DIR=/var/lib/watchdog"
# Список серверов владельца лежит рядом с данными бота; сторож читает его
# по группе watchdog, чтобы опрашивать удалённых агентов.
Environment="BOT_DATA_DIR=/var/lib/telegram-bot"

# Модель разбора выбирается файлом `watchdog/ai.json` — провайдер, модель,
# запасные варианты. Поменять ИИ = поставить там другую строку; код трогать
# не нужно, а сторож подхватит выбор следующим проходом (он одноразовый).
#
# Переменные ниже — только для провайдера Anthropic: ими задаётся, какая модель
# стоит в основном разборе и какая в запасе, если основной провайдер не
# ответил. Для MiniMax и любого OpenAI-совместимого адреса модель пишется
# прямо в `ai.json`.
#
# Настоящий крит берёт модель сильнее, но не чаще WATCHDOG_CRIT_PER_DAY раз в
# сутки — иначе ночь, когда посыпалось всё сразу, выела бы подписку целиком.
# Уточняющие вопросы по инциденту всегда идут на обычной модели.
Environment="WATCHDOG_MODEL=claude-sonnet-5"
Environment="WATCHDOG_MODEL_CRIT=claude-opus-5"
Environment="WATCHDOG_CRIT_PER_DAY=8"

# StateDirectory намеренно НЕ используется: он выставлял бы владельца по User и
# Group юнита на каждом старте и стирал бы группу watchdog, через которую бот
# читает вердикты. Каталог создаёт install.sh, а общий доступ держится на setgid.

# Иначе systemd ставит 0022, и всё созданное сторожем недоступно боту на
# запись: каталоги инцидентов получались 2750, и аудит нажатий не писался.
UMask=0002

# Разбор может занять до 10 минут (таймаут модели в `ai.json`) плюс сбор
# данных — запас нужен, иначе systemd убивает сторож на самом интересном.
TimeoutStartSec=900

# Усиление намеренно неполное: сторож вызывает sudo для трёх команд на чтение,
# поэтому NoNewPrivileges и RestrictSUIDSGID здесь сломают его самого.
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
