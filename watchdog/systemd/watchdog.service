[Unit]
Description=Сторож сервера: детекторы, разбор дельты, уведомления владельцу
Documentation=file:/home/plg/telegram-server-bot/docs/watchdog-roadmap.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=plg
Group=plg
WorkingDirectory=/home/plg/telegram-server-bot
ExecStart=/home/plg/telegram-server-bot/watchdog/run.sh

# Секреты отдаёт systemd — файл читает root, процессу достаются только значения.
EnvironmentFile=/etc/telegram-server-bot.env
# Telegram и Anthropic у провайдера недоступны напрямую; свои домены сборщик
# проверяет мимо прокси (см. collect.py).
Environment="HTTPS_PROXY=http://127.0.0.1:18443"
Environment="HTTP_PROXY=http://127.0.0.1:18443"
Environment="WATCHDOG_STATE_DIR=/var/lib/watchdog"
# Список серверов владельца лежит рядом с данными бота; сторож читает его
# по группе watchdog, чтобы опрашивать удалённых агентов.
Environment="BOT_DATA_DIR=/var/lib/telegram-bot"

# StateDirectory намеренно НЕ используется: он выставлял бы владельца по User и
# Group юнита на каждом старте и стирал бы группу watchdog, через которую бот
# читает вердикты. Каталог создаёт install.sh, а общий доступ держится на setgid.

TimeoutStartSec=600

# Усиление намеренно неполное: сторож вызывает sudo для трёх команд на чтение,
# поэтому NoNewPrivileges и RestrictSUIDSGID здесь сломают его самого.
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
