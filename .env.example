# Пример переменных окружения.
#
# Секреты НЕ хранятся в репозитории и НЕ хранятся в config.py.
# Боевое место токена — env-файл, читаемый только root:
#     /etc/telegram-server-bot.env      (0600 root:root)  — центральный бот
#     /etc/server-monitor.env           (0600 root:root)  — автономный monitor.sh
# systemd отдаёт их процессу через EnvironmentFile=, monitor.sh читает файл сам.

# Токен бота от @BotFather.
TELEGRAM_TOKEN=

# Telegram user id владельца — получает локальные алерты monitor.sh
OWNER_ID=

# Публичный IPv4 центрального сервера. Подставляется в команду установки агента,
# чтобы порт 5000 на наблюдаемой машине сразу открывался только ему.
# Автоопределение не годится: наружу машина ходит через мост, и внешние сервисы
# возвращают адрес выходного узла, а не свой.
# Адреса, с которых центральный сервер приходит к агентам. Через запятую, если
# маршрутов несколько: прямой и обходной через мост выходят наружу с разных IP,
# и указать один значит закрыть фаерволом второй.
CENTRAL_IP=
