# Пример переменных окружения.
#
# Секреты НЕ хранятся в репозитории и НЕ хранятся в config.py.
# Боевое место токена — env-файл, читаемый только root:
#     /etc/telegram-server-bot.env      (0600 root:root)  — центральный бот
#     /etc/server-monitor.env           (0600 root:root)  — автономный monitor.sh
# systemd отдаёт их процессу через EnvironmentFile=, monitor.sh читает файл сам.

# Токен бота от @BotFather.
TELEGRAM_TOKEN=

# Telegram user id владельца — получает локальные алерты monitor.sh
OWNER_ID=
